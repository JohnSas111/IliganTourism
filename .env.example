# Copy this file to ".env" (same folder as manage.py) and fill in the values.
# ".env" is ignored by Git. NEVER commit real keys.

# --- Local development ---
DEBUG=True

# Django signing key. Optional while DEBUG=True; REQUIRED when DEBUG=False.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# PayMongo TEST secret key (sk_test_...) from dashboard.paymongo.com -> Developers.
# Never use a live key (sk_live_...) on your laptop.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Identifies this app to OpenStreetMap's geocoder (their policy asks for contact details).
# Example: IliganTourismSystem/1.0 (yourname@example.com)
GEO_USER_AGENT=IliganTourismSystem/1.0 (student project)

# --- AI tourism assistant (Google Gemini) ---
# Free key from https://aistudio.google.com/apikey . Leave blank to hide the assistant.
# Google's free tier may use prompts to improve its products, so the assistant is built
# to send only public tourism information and the visitor's question (never account data).
GEMINI_API_KEY=
# Optional. Model IDs change; see https://aistudio.google.com/rate-limit for what your key can use.
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional: minimal | low | medium | high
# GEMINI_THINKING_LEVEL=low
# Optional limits (questions per visitor/minute, per visitor/day, whole site/day)
# ASSISTANT_PER_MINUTE=6
# ASSISTANT_PER_DAY=60
# ASSISTANT_SITE_PER_DAY=300

# --- Tourism images (Cloudinary) ---
# Free account: https://cloudinary.com/users/register_free
# Then open https://console.cloudinary.com/app/settings/api-keys and copy the three values.
# Leave all three blank to keep saving pictures in the local media/ folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional:
# CLOUDINARY_FOLDER=iligan_tourism
# IMAGE_MAX_UPLOAD_MB=8
# FREE PythonAnywhere accounts only (leave out on your laptop): outgoing traffic needs their proxy.
# CLOUDINARY_API_PROXY=http://proxy.server:3128

# Base URL PayMongo redirects back to after payment (no trailing slash).
SITE_URL=http://127.0.0.1:8000

# --- Production (PythonAnywhere) examples ---
# DEBUG=False
# ALLOWED_HOSTS=yourusername.pythonanywhere.com
# SITE_URL=https://yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com   (only if you get CSRF origin errors)
# SECURE_COOKIES=True   (default when DEBUG=False; set False only for DEBUG=False over http)
